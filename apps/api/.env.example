DATABASE_URL=postgresql://<username>:<password>@localhost:5433/monorepo_fastify_vue
# DATABASE_URL_UNPOOLED=... # Direct (non-pooled) connection string, used only for migrations. Required in production when DATABASE_URL is a pooled (PgBouncer) endpoint, e.g. Neon.
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# CORS_ORIGIN=http://localhost:5173 # Only needed for separate API/web origins.
# REDIS_URL=redis://localhost:6380 # Required in production for the shared rate-limit store; optional (in-memory) elsewhere.
